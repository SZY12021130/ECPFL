def plot_box(p, ul, dl, palette, filename):
    """箱线图。"""
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=(5, 4.5))
        bp = ax.boxplot(
            [ul, dl],
            tick_labels=["Upload", "Download"],
            patch_artist=True, widths=0.5, showfliers=True,
            flierprops=dict(marker="o", markersize=2, alpha=0.3),
        )
        for patch, color in zip(bp["boxes"], [palette["upload_fill"], palette["download_fill"]]):
            patch.set_facecolor(color)
            patch.set_alpha(0.6)
        for median in bp["medians"]:
            median.set_color("black")
            median.set_linewidth(1.5)
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Bandwidth Box Plot")
        ax.grid(True, linestyle="--", alpha=0.5, axis="y")
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_violin(p, ul, dl, palette, filename):
    """小提琴图。"""
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=(5, 4.5))
        parts = ax.violinplot([ul, dl], positions=[1, 2], showmeans=False, showmedians=True, showextrema=False)
        for i, pc in enumerate(parts["bodies"]):
            pc.set_facecolor([palette["upload_fill"], palette["download_fill"]][i])
            pc.set_alpha(0.6)
            pc.set_edgecolor("black")
            pc.set_linewidth(0.5)
        parts["cmedians"].set_color("black")
        parts["cmedians"].set_linewidth(1.5)
        ax.set_xticks([1, 2])
        ax.set_xticklabels(["Upload", "Download"])
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Bandwidth Violin Plot")
        ax.grid(True, linestyle="--", alpha=0.5, axis="y")
        np.random.seed(42)
        ax.scatter(np.ones(len(ul)) + np.random.normal(0, 0.06, len(ul)), ul,
                   s=1, alpha=0.15, color=palette["upload_line"])
        ax.scatter(2 * np.ones(len(dl)) + np.random.normal(0, 0.06, len(dl)), dl,
                   s=1, alpha=0.15, color=palette["download_line"])
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_strip_swarm(p, ul, dl, palette, filename, max_points=800):
    """
    条形抖动图 — 在箱线图基础上叠加 jitter 散点。

    结合了箱线图的统计摘要和原始数据点的分布展示。
    """
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=(6, 4.5))

        for i, (arr, color, label) in enumerate([
            (ul, palette["upload_fill"], "Upload"),
            (dl, palette["download_fill"], "Download"),
        ]):
            # 降采样
            if len(arr) > max_points:
                idx = np.random.choice(len(arr), max_points, replace=False)
                arr_s = arr[idx]
            else:
                arr_s = arr

            # 箱线图底层
            bp = ax.boxplot(
                [arr], positions=[i], widths=0.35,
                patch_artist=True, showfliers=False,
                manage_ticks=False,
            )
            bp["boxes"][0].set_facecolor(color)
            bp["boxes"][0].set_alpha(0.3)
            bp["medians"][0].set_color("black")
            bp["medians"][0].set_linewidth(1.2)

            # jitter 散点
            jitter = np.random.normal(0, 0.1, len(arr_s))
            ax.scatter(
                i + jitter, arr_s,
                s=3, alpha=0.25, color=color, edgecolors="none",
            )

        ax.set_xticks([0, 1])
        ax.set_xticklabels(["Upload", "Download"])
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Strip-Swarm Plot with Box Overlay")
        ax.grid(True, linestyle="--", alpha=0.5, axis="y")
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_comparison_bar(p, ul, dl, palette, filename):
    """统计量对比柱状图。"""
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=(6, 4))

        def stats(arr):
            return [np.min(arr), np.percentile(arr, 25), np.median(arr), np.percentile(arr, 75), np.max(arr)]

        ul_s, dl_s = stats(ul), stats(dl)
        labels = ["Min", "Q1", "Median", "Q3", "Max"]
        x_pos = np.arange(len(labels))
        width = 0.35

        ax.bar(x_pos - width / 2, ul_s, width, color=palette["upload_fill"],
               alpha=0.7, edgecolor="black", linewidth=0.5, label="Upload")
        ax.bar(x_pos + width / 2, dl_s, width, color=palette["download_fill"],
               alpha=0.7, edgecolor="black", linewidth=0.5, label="Download")

        ax.set_xticks(x_pos)
        ax.set_xticklabels(labels)
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Bandwidth Statistics Comparison")
        ax.legend(loc="upper left")
        ax.grid(True, linestyle="--", alpha=0.5, axis="y")

        for bars, vals in [(ax.patches[:5], ul_s), (ax.patches[5:], dl_s)]:
            for bar, v in zip(bars, vals):
                ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height(),
                        f"{v:.1f}", ha="center", va="bottom", fontsize=p.font_size - 3)

        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


