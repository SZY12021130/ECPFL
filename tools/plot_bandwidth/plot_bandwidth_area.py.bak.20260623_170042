def plot_ridge(p, ul, dl, palette, filename, n_bins=8):
    """
    岭线图 (Joy Plot) — 按上行带宽分桶，每层绘制上/下行的 KDE。

    优雅的堆叠分布图，清晰展示不同带宽区间的分布形态差异。
    """
    from scipy.stats import gaussian_kde

    with plt.style.context(p.style):
        fig, axes = plt.subplots(1, 2, figsize=(10, 5), sharey=False)

        for ax, arr, title, color in zip(
            axes, [ul, dl],
            ["Upload (KDE)", "Download (KDE)"],
            [palette["upload_fill"], palette["download_fill"]],
        ):
            sorted_idx = np.argsort(arr)
            n = len(arr)
            chunk = n // n_bins

            for i in range(n_bins):
                start = i * chunk
                end = (i + 1) * chunk if i < n_bins - 1 else n
                subset = arr[sorted_idx[start:end]]
                if len(subset) < 5:
                    continue

                log_sub = np.log10(subset[subset > 0])
                if len(log_sub) < 5:
                    continue
                kde = gaussian_kde(log_sub)
                x_kde = np.linspace(log_sub.min() - 0.3, log_sub.max() + 0.3, 300)
                y_kde = kde(x_kde)

                # 基线偏移
                baseline = i * (np.max(y_kde) * 1.6)
                ax.fill_between(
                    10 ** x_kde, baseline, baseline + y_kde,
                    color=color, alpha=0.25 + 0.06 * i, linewidth=0,
                )
                ax.plot(10 ** x_kde, baseline + y_kde, color=color, linewidth=0.7, alpha=0.7)
                # 标注区间
                mid = 10 ** np.mean(log_sub)
                ax.text(
                    mid, baseline + np.max(y_kde) * 1.15,
                    f"{np.min(subset):.0f}-{np.max(subset):.0f}",
                    fontsize=p.font_size - 4, ha="center", color=color, alpha=0.7,
                )

            ax.set_xscale("log")
            ax.set_title(title)
            ax.set_xlabel("Bandwidth (Mbps)")
            ax.grid(True, linestyle="--", alpha=0.3, which="both")
            ax.spines["left"].set_visible(False)
            ax.set_yticks([])

        fig.suptitle("Ridge Plot: Bandwidth Distribution by Quantile Bin", fontsize=p.font_size + 1, y=1.02)
        fig.tight_layout()
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


