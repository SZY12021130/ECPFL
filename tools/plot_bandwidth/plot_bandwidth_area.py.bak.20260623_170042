def plot_quantile_area(p, ul, dl, palette, filename, n_bins=10):
    """
    分位数分段面积图 — 将客户端按上行带宽分桶，
    每桶计算上/下行均值，用面积图展示分桶间的趋势变化。
    """
    bins_info = _bandwidth_bins(ul, n_bins=n_bins)

    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=(8, 4.5))

        x_labels = [b[0] for b in bins_info]
        x_pos = np.arange(len(x_labels))
        ul_means = [np.mean(ul[b[1]]) for b in bins_info]
        dl_means = [np.mean(dl[b[1]]) for b in bins_info]

        width = 0.85
        ax.bar(x_pos, ul_means, width, color=palette["upload_fill"], alpha=0.65,
               edgecolor=palette["upload_line"], linewidth=0.5, label="Upload (mean)")
        ax.bar(x_pos, dl_means, width, bottom=ul_means, color=palette["download_fill"], alpha=0.55,
               edgecolor=palette["download_line"], linewidth=0.5, label="Download (mean)")

        # 连线趋势
        ax.plot(x_pos, ul_means, "o-", color=palette["upload_line"], linewidth=1.0, markersize=3, alpha=0.8)
        ax.plot(x_pos, dl_means, "s-", color=palette["download_line"], linewidth=1.0, markersize=3, alpha=0.8)

        ax.set_xticks(x_pos)
        ax.set_xticklabels(x_labels, rotation=30, ha="right", fontsize=p.font_size - 3)
        ax.set_xlabel("Upload Bandwidth Bin (Mbps)")
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Quantile Binned: Upload & Download Mean per Bin")
        ax.legend(loc="upper left", fontsize=p.font_size - 1)
        ax.grid(True, linestyle="--", alpha=0.5, axis="y")

        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_heatstrip(p, ul, dl, palette, filename, sorted_indices=None):
    """
    带宽热力条 — 将所有客户端的带宽值映射为一行像素，
    按上行带宽排序，形成两条细长的热力条（上行 + 下行）。

    类似基因组学中的 Circos / heatmap stripe，直观展示带宽异构性的全景。
    """
    # 按 ul 排序
    sort_idx = np.argsort(ul)

    with plt.style.context(p.style):
        fig, axes = plt.subplots(2, 1, figsize=(14, 2.0), constrained_layout=True)

        for ax, arr, title, cmap_name in zip(
            axes,
            [ul[sort_idx], dl[sort_idx]],
            ["Upload", "Download"],
            ["Blues", "Reds"],
        ):
            # 将一维数组 reshape 为 (1, N) 以形成热力条
            img = np.array([arr[sort_idx]])
            im = ax.imshow(
                img, aspect="auto", cmap=cmap_name,
                interpolation="nearest",
            )
            ax.set_yticks([])
            ax.set_xticks([])
            ax.set_xlabel("Clients (sorted by upload bandwidth)", fontsize=p.font_size - 1)
            ax.set_title(title, fontsize=p.font_size, loc="left", pad=2)
            fig.colorbar(im, ax=ax, orientation="vertical", fraction=0.02, pad=0.01,
                         label="Mbps")

        fig.suptitle("Bandwidth Heatstrip: Client Heterogeneity Overview",
                     fontsize=p.font_size + 1, y=1.15)
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_waterfall(p, ul, dl, palette, filename, n_bins=10):
    """
    瀑布对比图 — 将客户端按上行带宽分为 N 段，
    用浮动柱状图展示上/下行带宽在各段中的均值，
    上下错开排列，形如瀑布。

    优雅地对比不同带宽区间的上/下行差异。
    """
    bins_info = _bandwidth_bins(ul, n_bins=n_bins)

    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=(8, 4.5))

        x_labels = [b[0] for b in bins_info]
        x_pos = np.arange(len(x_labels))
        ul_means = [np.mean(ul[b[1]]) for b in bins_info]
        dl_means = [np.mean(dl[b[1]]) for b in bins_info]
        gap = max(np.max(ul_means), np.max(dl_means)) * 0.15  # 中间间隔

        # 下行从 gap 开始向上画
        ax.bar(x_pos, ul_means, 0.7, bottom=0, color=palette["upload_fill"],
               alpha=0.65, edgecolor=palette["upload_line"], linewidth=0.5, label="Upload (mean)")
        ax.bar(x_pos, dl_means, 0.7, bottom=gap, color=palette["download_fill"],
               alpha=0.65, edgecolor=palette["download_line"], linewidth=0.5, label="Download (mean)")

        # 连接线：从上行顶端到下行底端
        for i in range(len(x_pos)):
            ax.plot([i, i], [ul_means[i], gap], color="gray", linewidth=0.8, linestyle="-.", alpha=0.5)

        # 基线
        ax.axhline(0, color="black", linewidth=0.5)
        ax.axhline(gap, color="black", linewidth=0.5, linestyle=":")

        ax.set_xticks(x_pos)
        ax.set_xticklabels(x_labels, rotation=30, ha="right", fontsize=p.font_size - 3)
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Waterfall: Upload vs. Download by Bandwidth Bin")
        ax.legend(loc="upper left", fontsize=p.font_size - 1)
        ax.grid(True, linestyle="--", alpha=0.5, axis="y")

        # 标注间隔
        ax.text(
            len(x_pos) - 0.5, gap / 2, "gap",
            ha="right", va="center", fontsize=p.font_size - 3, color="gray", style="italic",
        )

        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


