def _add_stats_box(ax, ul, dl, font_size):
    stats_text = (
        f"Upload:   median={np.median(ul):.2f} Mbps\n"
        f"Download: median={np.median(dl):.2f} Mbps\n"
        f"Clients:  {len(ul)}"
    )
    ax.text(
        0.98, 0.98, stats_text,
        transform=ax.transAxes, fontsize=font_size - 2,
        verticalalignment="top", horizontalalignment="right",
        bbox=dict(boxstyle="round,pad=0.4", facecolor="white", edgecolor="gray", alpha=0.85),
    )


def _bandwidth_bins(data, n_bins=10):
    """按上行带宽分成 n_bins 个分位数桶，返回 (labels, indices_list)。"""
    sorted_idx = np.argsort(data)
    n = len(data)
    chunk = n // n_bins
    bins = []
    for i in range(n_bins):
        start = i * chunk
        end = (i + 1) * chunk if i < n_bins - 1 else n
        lo = data[sorted_idx[start]]
        hi = data[sorted_idx[end - 1]]
        label = f"{lo:.0f}-{hi:.0f}"
        bins.append((label, sorted_idx[start:end]))
    return bins


