def plot_kde(p, ul, dl, palette, filename):
    """核密度估计曲线（对数空间）。"""
    from scipy.stats import gaussian_kde

    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=p.figsize)
        for arr, color, label in [
            (ul, palette["upload_fill"], "Upload"),
            (dl, palette["download_fill"], "Download"),
        ]:
            log_arr = np.log10(arr[arr > 0])
            kde = gaussian_kde(log_arr)
            x_kde = np.linspace(log_arr.min(), log_arr.max(), 500)
            y_kde = kde(x_kde)
            ax.fill_between(10 ** x_kde, y_kde, alpha=0.35, color=color, linewidth=0)
            ax.plot(10 ** x_kde, y_kde, color=color, linewidth=1.5, label=label)
        ax.set_xscale("log")
        ax.set_xlabel("Bandwidth (Mbps, log scale)")
        ax.set_ylabel("Density")
        ax.set_title("Kernel Density Estimation (KDE)")
        ax.legend(loc="upper right", fontsize=p.font_size - 1)
        ax.grid(True, linestyle="--", alpha=0.5, which="both")
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_kde_mirror(p, ul, dl, palette, filename):
    """
    镜面 KDE 对称图 — 上行向上、下行向下，形成蝴蝶/蝴蝶图。

    优雅地展示两个分布在同一轴上的对比关系。
    """
    from scipy.stats import gaussian_kde

    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=p.figsize)

        # 上行 → 向上
        log_ul = np.log10(ul[ul > 0])
        kde_ul = gaussian_kde(log_ul)
        x_kde = np.linspace(min(log_ul.min(), np.log10(dl[dl > 0]).min()) - 0.3,
                            max(log_ul.max(), np.log10(dl[dl > 0]).max()) + 0.3, 500)
        y_ul = kde_ul(x_kde)
        ax.fill_between(10 ** x_kde, 0, y_ul, color=palette["upload_fill"], alpha=0.5, linewidth=0)
        ax.plot(10 ** x_kde, y_ul, color=palette["upload_line"], linewidth=1.2, label="Upload")

        # 下行 → 向下（镜面翻转）
        log_dl = np.log10(dl[dl > 0])
        kde_dl = gaussian_kde(log_dl)
        x_kde2 = np.linspace(x_kde[0], x_kde[-1], 500)
        y_dl = kde_dl(x_kde2)
        ax.fill_between(10 ** x_kde2, 0, -y_dl, color=palette["download_fill"], alpha=0.5, linewidth=0)
        ax.plot(10 ** x_kde2, -y_dl, color=palette["download_line"], linewidth=1.2, label="Download")

        ax.axhline(0, color="black", linewidth=0.5)
        ax.set_xscale("log")
        ax.set_xlabel("Bandwidth (Mbps, log scale)")
        ax.set_ylabel("Density")
        ax.set_title("Mirror KDE: Upload (above) vs. Download (below)")
        ax.legend(loc="upper right", fontsize=p.font_size - 1)
        ax.grid(True, linestyle="--", alpha=0.5, which="both")

        # 标注
        ax.text(
            0.02, 0.98,
            f"Upload median: {np.median(ul):.2f} Mbps\nDownload median: {np.median(dl):.2f} Mbps",
            transform=ax.transAxes, fontsize=p.font_size - 2,
            va="top",
            bbox=dict(boxstyle="round,pad=0.3", facecolor="white", edgecolor="gray", alpha=0.85),
        )
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


