def plot_area(p, x, ul, dl, palette, filename, sort_by="ul_mbps"):
    """非堆叠面积图 — 两条半透明面积重叠展示。"""
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=p.figsize)
        ax.fill_between(x, 0, ul, color=palette["upload_fill"], alpha=0.45, linewidth=0)
        ax.fill_between(x, 0, dl, color=palette["download_fill"], alpha=0.30, linewidth=0)
        ax.plot(x, ul, color=palette["upload_line"], linewidth=0.8, alpha=0.9)
        ax.plot(x, dl, color=palette["download_line"], linewidth=0.8, alpha=0.9)
        ax.set_xlabel(f"Client Index (sorted by {sort_by})")
        ax.set_ylabel("Bandwidth (Mbps)")
        ax.set_title("Bandwidth Distribution: Upload vs. Download")
        ax.legend(
            handles=[
                plt.Line2D([0], [0], color=palette["upload_fill"], lw=6, alpha=0.5, label="Upload"),
                plt.Line2D([0], [0], color=palette["download_fill"], lw=6, alpha=0.35, label="Download"),
            ],
            loc="upper left", fontsize=p.font_size - 1,
        )
        ax.grid(True, linestyle="--", alpha=0.5)
        _add_stats_box(ax, ul, dl, p.font_size)
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


