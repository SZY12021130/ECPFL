def load_bandwidth_data(pkl_path: Path = PKL_PATH) -> dict:
    with open(pkl_path, "rb") as f:
        raw = pickle.load(f)
    data = {}
    for idx, val in raw.items():
        data[idx] = {
            "computation": float(val.get("computation", 0)),
            "communication": float(val.get("communication", 0)),
            "dl_mbps": float(val["dl_kbps"]) * KBPS_TO_MBPS,
            "ul_mbps": float(val["ul_kbps"]) * KBPS_TO_MBPS,
        }
    return data


def extract_arrays(data: dict, sort_by: str = "ul_mbps"):
    entries = []
    for idx, val in data.items():
        entries.append({"index": idx, "ul_mbps": val["ul_mbps"], "dl_mbps": val["dl_mbps"]})
    if sort_by:
        entries.sort(key=lambda e: e[sort_by])
    x = list(range(len(entries)))
    ul = np.array([e["ul_mbps"] for e in entries])
    dl = np.array([e["dl_mbps"] for e in entries])
    return x, ul, dl, entries


