def plot_scatter(p, ul, dl, palette, filename, max_points=3000):
    """上行 vs 下行散点图（含 Pearson r）。"""
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=p.figsize)
        n = len(ul)
        if n > max_points:
            idx = np.random.choice(n, max_points, replace=False)
            ul_s, dl_s = ul[idx], dl[idx]
        else:
            ul_s, dl_s = ul, dl
        ax.scatter(ul_s, dl_s, s=6, alpha=0.3, color=palette["upload_fill"], edgecolors="none")
        ax.axline((0, 0), slope=1, color="gray", linestyle="--", linewidth=0.8, alpha=0.5, label="y = x")
        corr = np.corrcoef(ul_s, dl_s)[0, 1]
        ax.text(
            0.02, 0.98, f"Pearson r = {corr:.3f}\nn = {n}",
            transform=ax.transAxes, fontsize=p.font_size - 2, va="top",
            bbox=dict(boxstyle="round,pad=0.4", facecolor="white", edgecolor="gray", alpha=0.85),
        )
        ax.set_xlabel("Upload Bandwidth (Mbps)")
        ax.set_ylabel("Download Bandwidth (Mbps)")
        ax.set_title("Upload vs. Download Bandwidth Correlation")
        ax.legend(loc="lower right", fontsize=p.font_size - 1)
        ax.grid(True, linestyle="--", alpha=0.5)
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_hexbin(p, ul, dl, palette, filename, gridsize=60):
    """
    六边形密度散点图 (Hexbin) — 大数据量散点图的优雅替代方案。

    用六边形的颜色深浅表示数据点密度，清晰展示上行/下行的联合分布热点。
    """
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=p.figsize)

        hb = ax.hexbin(ul, dl, gridsize=gridsize, cmap="YlOrRd",
                       mincnt=1, linewidths=0.2, edgecolors="gray")
        cb = fig.colorbar(hb, ax=ax, label="Count")

        ax.axline((0, 0), slope=1, color="black", linestyle="--", linewidth=0.8, alpha=0.5)

        # 标注高密度区域
        counts = hb.get_array()
        offsets = hb.get_offsets()
        if len(counts) > 0:
            top_idx = np.argsort(counts)[-1]
            top_x, top_y = offsets[top_idx]
            ax.annotate(
                f"Densest\n({top_x:.0f}, {top_y:.0f}) Mbps",
                xy=(top_x, top_y), fontsize=p.font_size - 3,
                ha="center", va="bottom",
                xytext=(10, 10), textcoords="offset points",
                arrowprops=dict(arrowstyle="->", color="black", lw=0.8),
                bbox=dict(boxstyle="round,pad=0.2", facecolor="white", edgecolor="gray", alpha=0.8),
            )

        ax.set_xlabel("Upload Bandwidth (Mbps)")
        ax.set_ylabel("Download Bandwidth (Mbps)")
        ax.set_title("Hexbin Density: Upload vs. Download Bandwidth")
        ax.grid(True, linestyle="--", alpha=0.3)

        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_ratio_dist(p, ul, dl, palette, filename, bins=100):
    """
    上行/下行带宽比分布图 + 散点图双面板。

    展示 dl/ul 比率的频率分布与位置关系，体现不对称性。
    """
    ratio = dl / np.maximum(ul, 1e-9)

    with plt.style.context(p.style):
        fig, axes = plt.subplots(1, 2, figsize=(10, 4.5), constrained_layout=True)

        # 左：ratio 直方图
        ax = axes[0]
        # 截断极端值便于可视化
        ratio_clip = np.clip(ratio, 0, np.percentile(ratio, 99))
        ax.hist(ratio_clip, bins=bins, color=palette["download_fill"], alpha=0.6,
                edgecolor="black", linewidth=0.3)
        ax.axvline(1.0, color="black", linestyle="--", linewidth=1.0, label="ratio = 1 (symmetric)")
        ax.axvline(np.median(ratio_clip), color=palette["upload_line"], linestyle="-.",
                   linewidth=1.2, label=f"median = {np.median(ratio_clip):.2f}")
        ax.set_xlabel("Download / Upload Ratio")
        ax.set_ylabel("Frequency (count)")
        ax.set_title("Bandwidth Ratio Distribution (DL/UL)")
        ax.legend(fontsize=p.font_size - 2)
        ax.grid(True, linestyle="--", alpha=0.5)

        # 右：散点 ul vs dl，按 ratio 着色
        ax2 = axes[1]
        n = len(ul)
        if n > 3000:
            idx = np.random.choice(n, 3000, replace=False)
            ul_s, dl_s, ratio_s = ul[idx], dl[idx], ratio[idx]
        else:
            ul_s, dl_s, ratio_s = ul, dl, ratio
        sc = ax2.scatter(ul_s, dl_s, c=ratio_s, s=4, alpha=0.3, cmap="RdYlBu_r",
                         edgecolors="none", vmin=0, vmax=np.percentile(ratio, 95))
        fig.colorbar(sc, ax=ax2, label="DL/UL Ratio")
        ax2.axline((0, 0), slope=1, color="gray", linestyle="--", linewidth=0.8, alpha=0.5)
        ax2.set_xlabel("Upload Bandwidth (Mbps)")
        ax2.set_ylabel("Download Bandwidth (Mbps)")
        ax2.set_title("Scatter Colored by DL/UL Ratio")
        ax2.set_xscale("log")
        ax2.set_yscale("log")
        ax2.grid(True, linestyle="--", alpha=0.5, which="both")

        fig.suptitle("Bandwidth Asymmetry Analysis", fontsize=p.font_size + 1)
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


