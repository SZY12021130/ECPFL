def plot_histogram(p, ul, dl, palette, filename, bins=80):
    """重叠直方图。"""
    with plt.style.context(p.style):
        fig, ax = plt.subplots(figsize=p.figsize)
        ax.hist(ul, bins=bins, color=palette["upload_fill"], alpha=0.55,
                edgecolor=palette["upload_line"], linewidth=0.5, label="Upload")
        ax.hist(dl, bins=bins, color=palette["download_fill"], alpha=0.45,
                edgecolor=palette["download_line"], linewidth=0.5, label="Download")
        ax.set_xlabel("Bandwidth (Mbps)")
        ax.set_ylabel("Frequency (count)")
        ax.set_title("Bandwidth Histogram: Upload vs. Download")
        ax.legend(loc="upper right", fontsize=p.font_size - 1)
        ax.grid(True, linestyle="--", alpha=0.5)
        _add_stats_box(ax, ul, dl, p.font_size)
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


def plot_histogram_side(p, ul, dl, palette, filename, bins=60):
    """上下并列直方图。"""
    with plt.style.context(p.style):
        fig, axes = plt.subplots(2, 1, figsize=(p.figsize[0], p.figsize[1] * 1.4), constrained_layout=True)
        for ax, arr, label, color, line_color in zip(
            axes, [ul, dl], ["Upload", "Download"],
            [palette["upload_fill"], palette["download_fill"]],
            [palette["upload_line"], palette["download_line"]],
        ):
            ax.hist(arr, bins=bins, color=color, alpha=0.6, edgecolor=line_color, linewidth=0.5)
            ax.axvline(np.median(arr), color=line_color, linestyle="--", linewidth=1.2,
                       label=f"median={np.median(arr):.1f} Mbps")
            ax.axvline(np.mean(arr), color="gray", linestyle=":", linewidth=1.0,
                       label=f"mean={np.mean(arr):.1f} Mbps")
            ax.set_xlabel("Bandwidth (Mbps)")
            ax.set_ylabel("Frequency (count)")
            ax.set_title(f"{label} Bandwidth Distribution")
            ax.legend(fontsize=p.font_size - 2)
            ax.grid(True, linestyle="--", alpha=0.5)
        p._save(filename, formats=["png", "pdf"])
        plt.close(fig)


