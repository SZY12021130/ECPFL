def generate_plots(
    pkl_path: Path = PKL_PATH,
    types: Optional[List[str]] = None,
    palette_name: str = "contrast",
    sort_by: str = "ul_mbps",
    output_dir=None,
):
    if output_dir is None:
        output_dir = TOOLS_DIR / "pic"
    output_dir = Path(output_dir)

    data = load_bandwidth_data(pkl_path)
    print(f"[INFO] 已加载 {len(data)} 条带宽记录 (单位: Mbps)")

    x, ul, dl, entries = extract_arrays(data, sort_by=sort_by)
    print(f"[INFO] Upload  — median={np.median(ul):.2f}, min={ul.min():.2f}, max={ul.max():.2f} Mbps")
    print(f"[INFO] Download — median={np.median(dl):.2f}, min={dl.min():.2f}, max={dl.max():.2f} Mbps")

    if types is None or "all" in types:
        types = list(PLOT_FUNCS.keys())

    if palette_name == "all":
        palettes = list(COLOR_PALETTES.keys())
    else:
        palettes = [palette_name]

    saved_all = []

    for pname in palettes:
        pal = COLOR_PALETTES[pname]
        print(f"\n{'=' * 60}")
        print(f"[PALETTE] {pal['label']}")
        print(f"{'=' * 60}")

        if len(palettes) > 1:
            sub_dir = output_dir / f"palette_{pname}"
            sub_dir.mkdir(parents=True, exist_ok=True)
        else:
            sub_dir = output_dir

        p = Plotter(
            style=["science", "grid"],
            figsize=(8, 4.5),
            dpi=300,
            output_dir=sub_dir,
            use_latex=False,
            font_size=12,
            theme="contrast",
        )

        for plot_type in types:
            if plot_type not in PLOT_FUNCS:
                print(f"  [SKIP] 未知类型: {plot_type}")
                continue

            base_name, func = PLOT_FUNCS[plot_type]
            fname = f"{base_name}_{pname}" if len(palettes) > 1 else base_name

            print(f"  [PLOT]  {plot_type:<20s} -> {fname}")
            try:
                if plot_type in ("area", "stacked"):
                    func(p, x, ul, dl, pal, fname, sort_by=sort_by)
                elif plot_type in ("scatter", "hexbin"):
                    func(p, ul, dl, pal, fname)
                else:
                    func(p, ul, dl, pal, fname)
                saved_all.append(fname)
            except Exception as e:
                print(f"  [ERROR] {plot_type}: {e}")

    print(f"\n{'=' * 60}")
    print(f"[DONE] 共生成 {len(saved_all)} 张图表")
    print(f"       输出目录: {output_dir}")
    print(f"{'=' * 60}")
    return saved_all


